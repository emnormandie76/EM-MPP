# Variables d'environnement (architecture §3.1). Valeurs factices.
# En local, les vraies valeurs sont dans .env.local, récupéré avec `vercel env pull .env.local`.
# Ne jamais committer de vraie valeur.

# Chaîne de connexion poolée à Neon (branche dev en local).
DATABASE_URL=postgresql://user:password@host.example.test/dbname?sslmode=require
# Chaîne de connexion directe, utilisée pour les migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example.test/dbname?sslmode=require

# Au moins 32 caractères aléatoires, une valeur différente par environnement.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# URL de base de l'application, base des adresses de retour du portail. Sur le poste, le port de
# `npm run dev`. Sur la branche de recette, son adresse fixe exacte. Non définie sur les autres
# prévisualisations Vercel, qui n'ont pas de connexion.
BETTER_AUTH_URL=http://localhost:3003

# Connexion par le Portail admission (contrat portail v1, architecture §3.1).
# Émetteur, sans barre finale : le même partout (poste, recette, production).
PORTAIL_ISSUER=https://portail.example.test/api/auth
# Client de l'environnement (dev sur le poste, recette sur la branche, production en production).
PORTAIL_CLIENT_ID=replace-with-the-client-id
PORTAIL_CLIENT_SECRET=replace-with-the-client-secret

# Tests uniquement, jamais définies sur Vercel :
# DB_DRIVER=pglite
# PGLITE_DIR=.pglite-e2e

# En local, sur un réseau qui bloque le port 5432 (celui de l'école) : Neon en WebSocket
# sur le port 443. À mettre dans .env.development.local, jamais sur Vercel.
# DB_DRIVER=neon-ws

# Fournies automatiquement par Vercel : VERCEL_URL, VERCEL_BRANCH_URL,
# VERCEL_PROJECT_PRODUCTION_URL, VERCEL_ENV.
